@page "/Editar/{AutorId:int}"
@rendermode InteractiveServer


<EditForm Models= @autor OnValidSubmit="@Modificar">
    <DataAnnotationsValidator/>

    <div class = "container mt-4">
        <div calss = "card shadow-lg">

            @*Header*@
            <div class = "card-header text-center">
                <h3>
                    <strong>
                        Editar Autro
                    </strong>
                </h3>

            </div>

            @*Body*@
            <div class ="card-body">
                <div class = "mt-3">
                    <label class ="form-label" for="IdAutor">
                        <strong>
                            Autor Id
                        </strong>
                    </label>
                    <InputNumber class = "form-control"
                                Id="IdAutor"
                                @bind-Value="autor.IdAutor"
                                readonly>
                    </InputNumber>
                </div>
            </div>

            @*Footer*@
            <div class = "card-footer text-center">
                <button type = button
                        class = "btn btn-secondary"
                        @onclick = "Volver"
                        Volver>
                </button>
                 <button type = submmit
                        class = "btn btn-warning"
                        Eliminar>
                </button>
                 <button type = button
                        class = "btn btn-danger"
                        @onclick="Eliminar"
                        Eliminar>
                </button>
            </div>
        </div>
    </div>
</EditForm>

@code{
    Autor autor = new Autor();
    public int autorId{get; set;}
    public void Volver()
    {
        Navigation.NavigateTo("/Index");
    }

    protected async Task OnInitialized()
    {
        autor = await AutorServices.Buscar(autorId);
    }

    public async Task Modificar()
    {
        var modificado = await AutorServices.Modificar(autor);
        if (modificado)
        {
            Volver();
        }
        else
        {
            Volver();
        }
    }
     public async Task Eliminar()
    {
        var modificado = await AutorServices.Eliminar(autorId);
        if (modificado)
        {
            Volver();
        }
        else
        {
            Volver();
        }
    }
}
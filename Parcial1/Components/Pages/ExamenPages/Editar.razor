@page "/Editar/{AutorId:int}"
@rendermode InteractiveServer


<PageTitle>Crear Autor</PageTitle>
<EditForm Model="@autor" OnValidSubmit="@Modificar">
    <DataAnnotationsValidator/>

    <div class="container mt-4">
        <div class="card shadow-lg">
              @*header*@
            <div class="card-header text-center">
                <h3>
                    <strong>Editar nuveo libro</strong>
                </h3>
            </div>
            
            
            @*Body*@
            <div class ="card-body">
            
                    <div class="mt-3">
                        <label class="form-label" for="IdAutor">
                            <strong>Autor Id</strong>
                        </label>
                        <InputNumber class="form-control"
                                    id="IdAutor"
                                    @bind-Value="autor.IdAutor"
                                    readoly>
                        </InputNumber>
                    </div>

                     <div class="mt-3">
                        <label class="form-label" for="Nombre">
                            <strong>Nombre</strong>
                        </label>
                        <InputText class="form-control"
                                    id="Nombre"
                                    @bind-Value="autor.Nombre"
                                    >
                        </InputText>
                    </div>

                    <div class="mt-3">
                        <label class="form-label" for="Nacionalidad">
                            <strong>Nacionalidad</strong>
                        </label>
                        <InputText class="form-control"
                                    id="Nacionalidad"
                                    @bind-Value="autor.Nacionalidad"
                                    >
                        </InputText>
                    </div>

                    <div class="mt-3">
                        <label class="form-label" for="FechaNacimiento">
                            <strong>Fecha de nacimiento</strong>
                        </label>
                        <InputDate class="form-control"
                                    id="FechaNacimiento"
                                    @bind-Value="autor.FechaNacimiento"
"
                                    >
                        </InputDate>
                    </div>

                    <div class="mt-3">
                        <label class="form-label" for="Sueldo">
                            <strong>Sueldo</strong>
                        </label>
                        <InputNumber class="form-control"
                                    id="Sueldo"
                                    @bind-Value="autor.Sueldo"
                                    >
                        </InputNumber>
                    </div>

                 
            </div>

            @*Footer*@
            <div class = "card-footer text-center">
                <button type="button"
                        class="btn btn-outline-primary"
                        @onclick="Volver">
                    Volver
                </button>

                  <button type="submit"
                        class="btn btn-warning">
                    Modificar
                </button>
                 
                  <button type="button"
                        class="btn btn-danger"
                        @onclick="Eliminar">
                    Eliminar
                </button>
            </div>
          
        </div>
    </div>
</EditForm>

@code{
    [Parameter]
    public int AutorId{get; set;}


   private Autor autor = new Autor();

    private async Task Modificar()
    {
        var crear = await AutorServices.Guardar(autor);
        if (crear)
        {
            Volver();
        }
    }

     protected override async Task OnInitializedAsync()
    {
        autor = await AutorServices.Buscar(AutorId);
    }

     private async Task Eliminar()
    {
        var crear = await AutorServices.Eliminar(autor.IdAutor);
        if (crear)
        {
            Volver();
        }
    }

    private void Volver()
    {
        Navigation.NavigateTo("/Index");
    }
    }




@page "/Index"
@rendermode InteractiveServer



<PageTitle>Pretamos</PageTitle>

<div class= "container">
    @*Header*@
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-center mb-4">
            <h5 class="card-title">Registro de Prestamos</h5>
            <a href="/Crear/" class="btn btn-primary"> <span class="bi bi-plus-square mt-3"></span> Crear</a>
        </div>

            @*Body*@
            <div class="card-body">
                 @*Labels*@
                <div class="row">
                    <div class = "col-3">
                        <label class ="form-label" for ="Filtro">
                             <strong>Filtrar por</strong>
                         </label>
                    </div>
                    <div class = "col-3">
                        <label class ="form-label" for ="Filtro">
                            <strong>Busqueda</strong>
                        </label>
                    </div>
                </div>

                @*Inputs y botones*@
                <div class="row">
                     @*FIltro*@
                    <div class="col-3">
                        <select class="form-select" @bind="filtro">
                             <option value ="">
                                Elija una opcion
                            </option>

                            <option value ="Nombre">
                                Nombre
                            </option>

                            <option value ="Nacionalidad">
                                 Nacionalidad
                            </option>

                        </select>
                    </div>

                @*Busqueda*@
                    <div class = "col-4">
                        <div class="input-group">

                            <input class ="form-control"
                                @bind="valorFiltro"
                                placeholder="Buscar" />
                            <button type="button"
                                class = "btn btn-outline-primary"
                                    @onclick="Buscar">
                                    buscar
                            </button>
                        </div>
                    </div>

                @*Restablecer*@
                    <div class = "col-auto">
                        <button type="button"
                            class = "btn btn-outline-secondary"
                                @onclick ="Restablecer">
                                Restablecer
                        </button >     
                    </div>
                 </div>
                 <div class = "mt-4">
                        <QuickGrid Items = "@listaAutores.AsQueryable()" class = "table table-bordered">
                            <PropertyColumn Property="@(a => a.IdAutor)" Title="Autor Id"Align = "Align.Center"Sortable = "true"></PropertyColumn>
                            <PropertyColumn Property="@(a=>a.Nombre)" Title="Nombre Autor"Align = "Align.Center" Sortable = "true"></PropertyColumn>
                            <PropertyColumn Property="@(a=>a.Nacionalidad)" Title="Nacionalidad"Align = "Align.Center" Sortable = "true"></PropertyColumn>
                            <PropertyColumn Property="@(a=>a.FechaNacimiento)" Title="Fecha de Nacimiento"Align = "Align.Center" Sortable = "true"></PropertyColumn>
                            <PropertyColumn Property="@(a=>a.Sueldo)" Title="Sueldo"Align = "Align.Center" Sortable = "true"></PropertyColumn>
                            <TemplateColumn Title = "Acciones">
                                <div>
                                    <a href = "@($"/Editar/{context.IdAutor}")"class ="btn btn-outline-warning">Editar</a>
                                    <a href = "@($"/Editar/{context.IdAutor}")"class ="btn btn-outline-danger">Eliminar</a>
                                </div>
                            </TemplateColumn> 
                        </QuickGrid>
                    </div>
                <div>
                    <p>
                        <strong>Cantidad: @listaAutores.Count</strong>
                    </p>
                    <p>
                        <strong>Suma de sueldo: @listaAutores.Sum(a => a.Sueldo)</strong>
                    </p>
                </div>
        </div>
    </div>
</div>


@code {
       private string filtro = "";
       private string valorFiltro = "";
         public List<Autor> listaAutores= [];

    protected override async Task OnInitializedAsync()
    {
        listaAutores = await AutorServices.GetList(p => p.IdAutor >0);
    }

        public async Task Restablecer(){
            filtro = string.Empty;
            valorFiltro =string.Empty;
            listaAutores = await AutorServices.ListarTodo();
        }

        public async Task Buscar(){
            if(filtro != ""){
                if(filtro == "Nombre"){
                    listaAutores = await AutorServices.GetList(d => d.Nombre.ToLower().Contains(valorFiltro.ToLower()));
                }
                if(filtro == "Nacionalidad"){
                    listaAutores = await AutorServices.GetList(d => d.Nacionalidad.ToLower().Contains(valorFiltro.ToLower()));
                }
            }
        } 

         
   }
